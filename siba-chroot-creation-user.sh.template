#!/bin/bash
# siba-chroot-creation-user.sh - Crea un usuario chroot en el sistema

USUARIO=""
JAIL=""
JAIL_ORIGEN=""
ELIMINAR=false
PERMITIR_SHELL=false
MODO_SFTP_EXPLICITO=false
MODO_SHELL_EXPLICITO=false

mostrar_ayuda() {
    cat <<EOF
Uso: $0 [OPCIONES] --usuario USUARIO

Crea o elimina un usuario con entorno chroot para SSH/SFTP.

Modo creación (por defecto):
  -u, --usuario USUARIO    Nombre del usuario (obligatorio)
  -j, --jail JAIL          Ruta del chroot destino (por defecto: /opt/jail/USUARIO)
  -o, --origen JAIL_ORIGEN Ruta del chroot de referencia (opcional)
      --solo-sftp          Restringe al usuario a SFTP (por defecto)
      --shell              Permite shell interactivo además de SFTP
  -h, --help               Muestra esta ayuda

Modo eliminación:
  -d, --delete             Elimina el usuario y su chroot. El cambio global
                           'Subsystem sftp internal-sftp -l VERBOSE' se conserva
                           mientras existan otros usuarios chroot creados por
                           este script; al borrar el último, sshd_config vuelve
                           a su estado anterior (respaldo *.siba-bak)

Por defecto el usuario queda restringido a SFTP y usa el internal-sftp
embebido en el sshd del host, sin copias dentro del chroot. Con --shell
se conserva el shell interactivo y se configura el host con
'Subsystem sftp internal-sftp -l VERBOSE' (afecta el SFTP de todo el host).
En ambos modos las operaciones de archivo por SFTP se registran en
/var/log/auth.log del host (nivel VERBOSE).

Si no se especifica --origen, el script busca /opt/jail/siba.tar.gz.
Si no existe el tarball, crea una base mínima manual con solo lo
necesario para SSH/SFTP.

Ejemplos:
  $0 -u juan                       # crear usuario solo SFTP (base automática)
  $0 -u juan --shell               # crear usuario con shell + SFTP
  $0 -u juan -o /opt/jail/base     # crear desde base existente
  $0 -d -u juan                    # eliminar usuario y limpiar
EOF
    exit 0
}

eliminar_usuario() {
    JAIL="${JAIL:-/opt/jail/${USUARIO}}"
    SSHD_CONFIG="/etc/ssh/sshd_config.d/${USUARIO}.conf"

    echo "🗑️  Eliminando usuario ${USUARIO}..."

    if [ -f "${SSHD_CONFIG}" ]; then
        rm -f "${SSHD_CONFIG}"
        echo "  ✅ Configuración SSH eliminada: ${SSHD_CONFIG}"
    else
        echo "  ℹ️  No existe configuración SSH para ${USUARIO}"
    fi

    if id "${USUARIO}" &>/dev/null; then
        userdel -r "${USUARIO}" 2>/dev/null
        echo "  ✅ Usuario ${USUARIO} eliminado del sistema"
    else
        echo "  ℹ️  El usuario ${USUARIO} no existe en el sistema"
    fi

    if [ -d "${JAIL}" ]; then
        # Desmontar los bind mounts de la jail antes de borrarla (evita que
        # rm -rf intente eliminar el socket /dev/log del host y deje basura).
        while read -r _ mp _; do
            case "${mp}" in
                "${JAIL}"/*) umount "${mp}" 2>/dev/null || umount -l "${mp}" 2>/dev/null || true ;;
            esac
        done < /proc/mounts
        grep -v "^[^ ]* ${JAIL}/" /etc/fstab > /etc/fstab.siba-tmp 2>/dev/null \
            && grep -q " ${JAIL}/" /etc/fstab \
            && mv /etc/fstab.siba-tmp /etc/fstab \
            && echo "  ✅ Entrada de ${JAIL} eliminada de /etc/fstab"
        rm -f /etc/fstab.siba-tmp
        rm -rf "${JAIL}"
        echo "  ✅ Chroot eliminado: ${JAIL}"
    else
        echo "  ℹ️  No existe el chroot ${JAIL}"
    fi

    # Regla de seguridad: la modificación global de sshd ('Subsystem sftp
    # internal-sftp -l VERBOSE') pertenece al CONJUNTO de usuarios chroot del
    # host, no al usuario que se elimina. Se conserva mientras quede algún otro
    # usuario chroot creado por este script; solo se revierte cuando se borra
    # el último, devolviendo sshd_config a su estado previo (desde *.siba-bak).
    # /etc/fstab y el bind de /dev/log son por jail y ya se limpiaron arriba.
    OTROS_CHROOT=$(grep -rl "Configuración chroot para" /etc/ssh/sshd_config.d/ \
        --exclude='*.siba-bak' 2>/dev/null || true)
    # Armar la lista de respaldos sin usar 'ls': si el glob no casa ningún
    # archivo queda el literal y ls devuelve error AUNQUE exista el otro
    # respaldo (eso saltaba la restauración en silencio).
    RESPALDOS=()
    for respaldo in /etc/ssh/sshd_config.siba-bak /etc/ssh/sshd_config.d/*.siba-bak; do
        [ -f "${respaldo}" ] && RESPALDOS+=("${respaldo}")
    done

    if [ -n "${OTROS_CHROOT}" ]; then
        echo "  ℹ️  Quedan otros usuarios chroot; se conserva el"
        echo "     'Subsystem sftp internal-sftp -l VERBOSE' global (respaldo *.siba-bak):"
        echo "${OTROS_CHROOT}" | sed 's/^/       - /'
    elif [ "${#RESPALDOS[@]}" -gt 0 ]; then
        echo "  ↩️  No quedan usuarios chroot: restaurando la configuración global de sshd..."
        for respaldo in "${RESPALDOS[@]}"; do
            original="${respaldo%.siba-bak}"
            if ! cp -a "${respaldo}" "${original}"; then
                echo "  ⚠️  No se pudo restaurar ${original}; se conserva ${respaldo}"
                continue
            fi
            mkdir -p /run/sshd
            if sshd -t >/dev/null 2>&1; then
                rm -f "${respaldo}"
                echo "  ✅ Restaurada la configuración anterior de ${original} (respaldo eliminado)"
            else
                echo "  ⚠️  sshd -t rechaza la configuración restaurada de ${original}"
                echo "     Se conserva el respaldo ${respaldo} para revisión manual"
            fi
        done
    else
        echo "  ℹ️  Sin respaldos *.siba-bak: la configuración global de sshd no fue"
        echo "     modificada por este script (o ya fue restaurada), no hay nada que revertir"
    fi

    echo "🔍 Validando configuración SSH..."
    mkdir -p /run/sshd
    if sshd -t; then
# El servicio SSH puede llamarse sshd, ssh o ssh.service según la distro
SSH_SERVICE=$(systemctl list-unit-files --type=service 2>/dev/null | grep -oP '^ssh[d]?\.service' | head -1) || true
SSH_SERVICE="${SSH_SERVICE:-ssh.service}"
systemctl restart "${SSH_SERVICE}"
        echo "✅ SSH reiniciado correctamente"
    else
        echo "⚠️  Configuración SSH inválida, revisar manualmente"
    fi

    echo "✅ Usuario ${USUARIO} eliminado por completo"
    exit 0
}

# Asegura que el subsistema SFTP global use internal-sftp con registro de
# operaciones de archivo (nivel VERBOSE), de modo que las transferencias SFTP
# queden en /var/log/auth.log. Solo se usa en modo --shell: en modo solo SFTP
# se configura por usuario con ForceCommand y no se toca la configuración global.
#
# OpenSSH no permite definir 'Subsystem sftp' más de una vez. Por eso no se
# agrega un drop-in: se reemplaza la definición existente (con respaldo), que
# normalmente vive en /etc/ssh/sshd_config. Si la validación falla se restaura.
asegurar_internal_sftp_global() {
    local dropin="/etc/ssh/sshd_config.d/00-siba-sftp-internal.conf"
    local efectivo cmd archivo respaldo salida linea_nueva nivel_log="VERBOSE"

    echo "🔐 Verificando el subsistema SFTP global para el modo shell..."

    mkdir -p /run/sshd /etc/ssh/sshd_config.d

    # Limpiar el drop-in generado por versiones anteriores del script: era la
    # causa del error "Subsystem 'sftp' already defined".
    if [ -f "${dropin}" ] && grep -q 'Generado por siba-chroot-creation-user.sh' "${dropin}" 2>/dev/null; then
        rm -f "${dropin}"
        echo "ℹ️  Se eliminó ${dropin} (drop-in obsoleto de una versión anterior)"
    fi

    if ! salida=$(sshd -T 2>/dev/null); then
        echo "❌ No se pudo leer la configuración efectiva de sshd (sshd -T)"
        echo "   Revise la configuración de SSH antes de continuar."
        return 1
    fi

    efectivo=$(echo "${salida}" | awk '/^subsystem[[:space:]]+sftp[[:space:]]/{print; exit}')

    if [ -z "${efectivo}" ]; then
        echo "❌ No se encontró una directiva 'Subsystem sftp' en la configuración de sshd"
        return 1
    fi

    linea_nueva="Subsystem sftp internal-sftp -l ${nivel_log}"

    # Ya está internal-sftp y además registra operaciones (VERBOSE o superior).
    if echo "${efectivo}" | grep -q 'internal-sftp' \
        && echo "${efectivo}" | grep -qE '(^|[[:space:]])-l[[:space:]]+(VERBOSE|DEBUG[0-9]*|[5-7])'; then
        echo "✅ Subsystem sftp ya usa internal-sftp con logging ${nivel_log}"
        return 0
    fi

    # Si no usa internal-sftp, validar que sea el sftp-server estándar antes de
    # reemplazarlo. Si ya usa internal-sftp solo falta agregar el nivel de log.
    if ! echo "${efectivo}" | grep -q 'internal-sftp'; then
        cmd=$(echo "${efectivo}" | sed -E 's/^subsystem[[:space:]]+sftp[[:space:]]+//')

        case "${cmd}" in
            /usr/lib/openssh/sftp-server*)
                ;;
            *)
                echo "❌ Subsystem sftp usa un wrapper o ruta no estándar: ${cmd}"
                echo "   Ajuste manualmente /etc/ssh/sshd_config para usar internal-sftp."
                return 1
                ;;
        esac
    fi

    # Localizar el archivo que contiene la definición activa de Subsystem sftp.
    archivo=$(grep -rlE '^[[:space:]]*Subsystem[[:space:]]+sftp([[:space:]]|$)' \
        /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1)
    if [ -z "${archivo}" ]; then
        echo "❌ No se encontró el archivo que define 'Subsystem sftp'"
        return 1
    fi

    # Respaldar SOLO si no existe uno previo: .siba-bak debe conservar el
    # estado original (anterior a la creacion del primer usuario chroot),
    # no un estado intermedio de ejecuciones anteriores de este script.
    respaldo="${archivo}.siba-bak"
    if [ -e "${respaldo}" ]; then
        echo "   (se conserva el respaldo original previo: ${respaldo})"
    elif ! cp -a "${archivo}" "${respaldo}"; then
        echo "❌ No se pudo respaldar ${archivo}"
        return 1
    fi

    # Reemplazar únicamente la primera definición activa (no líneas comentadas).
    if ! sed -i -E "0,/^[[:space:]]*Subsystem[[:space:]]+sftp([[:space:]]+.*)?\$/s//${linea_nueva}/" "${archivo}"; then
        cp -a "${respaldo}" "${archivo}"
        echo "❌ No se pudo modificar ${archivo}; se restauró el respaldo"
        return 1
    fi

    if ! sshd -t; then
        cp -a "${respaldo}" "${archivo}"
        echo "❌ Configuración SSH inválida; se restauró ${archivo} desde ${respaldo}"
        return 1
    fi

    efectivo=$(sshd -T 2>/dev/null | awk '/^subsystem[[:space:]]+sftp[[:space:]]/{print; exit}')
    if ! echo "${efectivo}" | grep -q 'internal-sftp' \
        || ! echo "${efectivo}" | grep -qE '(^|[[:space:]])-l[[:space:]]+VERBOSE'; then
        cp -a "${respaldo}" "${archivo}"
        echo "⚠️  El cambio no quedó activo; se restauró ${archivo} desde ${respaldo}"
        return 1
    fi

    echo "✅ Subsystem sftp ahora usa internal-sftp con logging ${nivel_log} (${archivo})"
    echo "   Las operaciones SFTP se registrarán en /var/log/auth.log"
    echo "   Respaldo de la configuración anterior: ${respaldo}"
    return 0
}

# --- Utilidades para preparar y poblar la base del chroot ------------------
# La base puede venir en dos layouts distintos:
#   * clásico:  bin/, lib/, lib64/ con el contenido real.
#   * usrmerge: bin -> usr/bin, lib -> usr/lib, lib64 -> usr/lib64, o bien
#               bin/, lib/, lib64/ materializados vacíos con el contenido
#               real en usr/bin/, usr/lib/, usr/lib64/.
# Estas funciones aceptan ambos para no depender de una ruta fija.

base_tiene_binarios() {
    local base="${1:-${JAIL_BASE}}"
    find -L "${base}/bin" "${base}/usr/bin" -maxdepth 1 \
        -type f -print -quit 2>/dev/null | grep -q .
}

base_tiene_librerias() {
    local base="${1:-${JAIL_BASE}}"
    find -L "${base}/lib" "${base}/lib64" "${base}/usr/lib" "${base}/usr/lib64" \
        -maxdepth 4 -type f -name 'lib*.so*' -print -quit 2>/dev/null | grep -q .
}

base_es_valida() {
    local base="${1:-${JAIL_BASE}}"
    base_tiene_binarios "${base}" && base_tiene_librerias "${base}"
}

copiar_arbol() {
    local origen="$1" destino="$2"
    [ -d "${origen}" ] || return 0
    mkdir -p "${destino}"
    cp -a "${origen}/." "${destino}/" 2>/dev/null || true
}

buscar_binario_base() {
    local nombre="$1" ruta
    for ruta in "/bin/${nombre}" "/usr/bin/${nombre}" "/sbin/${nombre}" "/usr/sbin/${nombre}"; do
        if [ -e "${JAIL_ORIGEN}${ruta}" ] || [ -L "${JAIL_ORIGEN}${ruta}" ]; then
            printf '%s\n' "${JAIL_ORIGEN}${ruta}"
            return 0
        fi
    done
    return 1
}

buscar_binario_host() {
    local nombre="$1" ruta
    for ruta in "/bin/${nombre}" "/usr/bin/${nombre}" "/sbin/${nombre}" "/usr/sbin/${nombre}"; do
        if [ -f "${ruta}" ]; then
            printf '%s\n' "${ruta}"
            return 0
        fi
    done
    return 1
}

crear_base_minima() {
    local base="$1"
    local cmd lib linker f
    local -a binarios

    mkdir -p "${base}"/{bin,dev,etc,home,lib,lib64,proc,tmp,usr/bin,usr/lib,usr/lib64}

    # Binarios mínimos para SSH + transferencia de archivos
    binarios=(
        /bin/dash      /bin/bash     /bin/sh
        /bin/ls        /bin/cat      /bin/cp
        /bin/mv        /bin/rm       /bin/mkdir
        /bin/rmdir     /bin/chmod    /bin/touch
        /bin/ln        /bin/pwd      /bin/echo
        /bin/date      /bin/grep     /bin/sed
        /bin/more
    )

    # El cliente scp solo se incluye si el usuario tendrá shell interactivo.
    if [ "${PERMITIR_SHELL}" = true ]; then
        binarios+=(/usr/bin/scp)
    fi

    for cmd in "${binarios[@]}"; do
        if [ -f "$cmd" ]; then
            install -m 755 "$cmd" "${base}${cmd}" 2>/dev/null || true
        fi
    done

    # Resolver dependencias con ldd
    for cmd in $(find "${base}/bin" "${base}/usr/bin" -type f 2>/dev/null); do
        ldd "$cmd" 2>/dev/null | grep "=> /" | awk '{print $3}' | while read lib; do
            if [ -f "$lib" ]; then
                install -D -m 644 "$lib" "${base}${lib}" 2>/dev/null || true
            fi
        done
    done

    # Linker
    for linker in /lib64/ld-linux-x86-64.so.2 /lib/ld-linux.so.2 /lib64/ld-linux-aarch64.so.1; do
        if [ -f "$linker" ]; then
            install -D -m 755 "$linker" "${base}${linker}" 2>/dev/null || true
        fi
    done

    # Archivos esenciales de /etc
    for f in /etc/nsswitch.conf /etc/hosts /etc/host.conf /etc/resolv.conf /etc/localtime /etc/protocols /etc/services /etc/ld.so.conf; do
        if [ -f "$f" ]; then
            cp "$f" "${base}${f}" 2>/dev/null || true
        fi
    done

    # Dispositivos
    mknod -m 666 "${base}/dev/null" c 1 3 2>/dev/null || true
    mknod -m 666 "${base}/dev/zero" c 1 5 2>/dev/null || true
    mknod -m 644 "${base}/dev/random" c 1 8 2>/dev/null || true
    mknod -m 644 "${base}/dev/urandom" c 1 9 2>/dev/null || true

    # .bashrc base
    mkdir -p "${base}/home/usuario"
    cat > "${base}/home/usuario/.bashrc" << 'BASHRC'
PS1='[\u@\h:\w]$ '
export PATH=/bin:/usr/bin
export TERM=xterm-256color
alias ll='ls -la'
BASHRC
}

reemplazar_base() {
    local nueva="$1" vieja="${JAIL_BASE}.old"
    rm -rf "${vieja}"
    if [ -e "${JAIL_BASE}" ]; then
        mv "${JAIL_BASE}" "${vieja}" || return 1
    fi
    if ! mv "${nueva}" "${JAIL_BASE}"; then
        [ -e "${vieja}" ] && mv "${vieja}" "${JAIL_BASE}"
        return 1
    fi
    rm -rf "${vieja}"
}

preparar_base() {
    local tmp
    mkdir -p "$(dirname "${JAIL_BASE}")"
    if [ -f "${TAR_BASE}" ]; then
        echo "📦 Usando archivo base ${TAR_BASE}"
        if base_es_valida "${JAIL_BASE}"; then
            echo "✅ Usando base existente válida en ${JAIL_BASE}"
            return 0
        fi
        echo "⚠️  La base ${JAIL_BASE} no existe o está incompleta; se extrae de nuevo"
        tmp="$(mktemp -d "${JAIL_BASE}.tmp.XXXXXX")" || return 1
        # Se ignoran los errores de mknod: los dispositivos se crean después.
        tar -xzf "${TAR_BASE}" -C "${tmp}" --strip-components=1 2>/dev/null || true
        if ! base_es_valida "${tmp}"; then
            echo "❌ El tarball ${TAR_BASE} no contiene binarios/librerías utilizables"
            rm -rf "${tmp}"
            return 1
        fi
        reemplazar_base "${tmp}" || { rm -rf "${tmp}"; return 1; }
        echo "✅ Base extraída en ${JAIL_BASE}"
    else
        echo "📦 No se encontró ${TAR_BASE}, creando base mínima manual..."
        tmp="$(mktemp -d "${JAIL_BASE}.tmp.XXXXXX")" || return 1
        crear_base_minima "${tmp}"
        if ! base_es_valida "${tmp}"; then
            echo "❌ No fue posible crear una base mínima válida"
            rm -rf "${tmp}"
            return 1
        fi
        reemplazar_base "${tmp}" || { rm -rf "${tmp}"; return 1; }
        echo "✅ Base mínima creada en ${JAIL_BASE}"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--usuario)
            USUARIO="$2"
            shift 2
            ;;
        -j|--jail)
            JAIL="$2"
            shift 2
            ;;
        -o|--origen)
            JAIL_ORIGEN="$2"
            shift 2
            ;;
        -d|--delete)
            ELIMINAR=true
            shift
            ;;
        --solo-sftp)
            PERMITIR_SHELL=false
            MODO_SFTP_EXPLICITO=true
            shift
            ;;
        --shell|--permitir-shell)
            PERMITIR_SHELL=true
            MODO_SHELL_EXPLICITO=true
            shift
            ;;
        -h|--help)
            mostrar_ayuda
            ;;
        *)
            echo "Error: Opción desconocida: $1"
            echo "Use $0 --help para más información."
            exit 1
            ;;
    esac
done

if [ "${MODO_SFTP_EXPLICITO}" = true ] && [ "${MODO_SHELL_EXPLICITO}" = true ]; then
    echo "❌ Error: --solo-sftp y --shell son mutuamente excluyentes"
    exit 1
fi

# Valores por defecto
JAIL="${JAIL:-/opt/jail/${USUARIO}}"
SSHD_CONFIG="/etc/ssh/sshd_config.d/${USUARIO}.conf"

# Validaciones
if [ -z "${USUARIO}" ]; then
    echo "❌ Error: Debe especificar un nombre de usuario con --usuario"
    exit 1
fi

# Modo eliminación
if [ "${ELIMINAR}" = true ]; then
    eliminar_usuario
fi

TAR_BASE="/opt/jail/siba.tar.gz"
JAIL_BASE="/opt/jail/siba-base"

if [ -z "${JAIL_ORIGEN}" ]; then
    preparar_base || exit 1
    JAIL_ORIGEN="${JAIL_BASE}"
fi

# Verificar que existe el ${JAIL_ORIGEN} como referencia
if [ ! -d "${JAIL_ORIGEN}" ]; then
    echo "❌ Error: No existe ${JAIL_ORIGEN} para copiar la configuración"
    exit 1
fi

# En modo shell se necesita que el subsistema SFTP global use internal-sftp,
# porque 'Subsystem' no está permitido dentro de un bloque Match.
if [ "${PERMITIR_SHELL}" = true ]; then
    asegurar_internal_sftp_global || exit 1
fi

echo "📦 Creando chroot para ${USUARIO} (igual a ${JAIL_ORIGEN})"

# 1. Crear usuario en el sistema host (si no existe)
if ! id "${USUARIO}" &>/dev/null; then
     useradd -M -s /bin/bash "${USUARIO}"
    echo "🔑 Estableciendo contraseña para ${USUARIO}"
     passwd "${USUARIO}"
else
    echo "⚠️  El usuario ${USUARIO} ya existe"
fi

# Obtener UID y GID del usuario
UID_USUARIO=$(id -u ${USUARIO})
GID_USUARIO=$(id -g ${USUARIO})

# 2. Crear estructura de directorios
echo "📁 Creando estructura de directorios..."
# Se usa el layout usrmerge (igual que la base de referencia): bin, lib y lib64
# son enlaces a usr/*. Así las rutas de los binarios, del intérprete ELF y de
# ldd son coherentes sin depender del layout de la base de origen.
mkdir -p "${JAIL}"/{etc,home/${USUARIO},dev,proc,tmp,usr/bin,usr/lib,usr/lib64,usr/sbin}
for enlace in bin lib lib64; do
    if [ -d "${JAIL}/${enlace}" ] && [ ! -L "${JAIL}/${enlace}" ]; then
        mkdir -p "${JAIL}/usr/${enlace}"
        cp -a "${JAIL}/${enlace}/." "${JAIL}/usr/${enlace}/" 2>/dev/null || true
        rm -rf "${JAIL}/${enlace}"
    fi
    ln -sfn "usr/${enlace}" "${JAIL}/${enlace}"
done

# 3. Crear /etc/passwd (EXACTAMENTE como ${JAIL_ORIGEN})
echo "📄 Creando /etc/passwd con solo root y ${USUARIO}..."
 bash -c "cat > ${JAIL}/etc/passwd << 'EOF'
${USUARIO}:x:${UID_USUARIO}:${GID_USUARIO}::/home/${USUARIO}:/bin/bash
root:x:0:0:root:/root:/bin/bash
EOF"
chmod 644 "${JAIL}/etc/passwd"

# 4. Crear /etc/group (solo root y usuario)
echo "📄 Creando /etc/group con solo root y ${USUARIO}..."
bash -c "cat > ${JAIL}/etc/group << 'EOF'
root:x:0:
${USUARIO}:x:${GID_USUARIO}:
EOF"
 chmod 644 "${JAIL}/etc/group"

# 5. NO crear /etc/shadow (la autenticación la maneja el host)
# 6. NO crear /etc/gshadow

# 7. Copiar archivos de configuración desde ${JAIL_ORIGEN}
echo "📄 Copiando archivos de configuración desde ${JAIL_ORIGEN}/etc/..."

# Archivos que DEBEMOS copiar (los que tiene ${JAIL_ORIGEN})
ARCHIVOS_A_COPIAR=(
    "alternatives"
    "bash.bashrc"
    "host.conf"
    "hosts"
    "issue"
    "ld.so.cache"
    "ld.so.conf"
    "localtime"
    "nsswitch.conf"
    "profile"
    "protocols"
    "resolv.conf"
    "services"
    "terminfo"
)

for archivo in "${ARCHIVOS_A_COPIAR[@]}"; do
    if [ -e "${JAIL_ORIGEN}/etc/${archivo}" ]; then
         cp -r "${JAIL_ORIGEN}/etc/${archivo}" "${JAIL}/etc/" 2>/dev/null || true
        echo "  ✅ Copiado: ${archivo}"
    fi
done

# 8. NO copiar passwd, group, shadow, gshadow desde ${JAIL_ORIGEN}
# (ya los creamos manualmente de forma segura)

# 9. Copiar binarios y librerías
echo "🔧 Copiando binarios y librerías..."

declare -A BINARIOS_REQUERIDOS=()

# 9.1. Tomar como referencia todos los binarios de la base, estén en bin/ o en
# usr/bin/. Antes solo se leía ${JAIL_ORIGEN}/bin, por lo que una base usrmerge
# (contenido en usr/bin y bin vacío) dejaba el jail sin binarios.
for dir_base in "${JAIL_ORIGEN}/bin" "${JAIL_ORIGEN}/usr/bin"; do
    [ -d "${dir_base}" ] || continue
    while IFS= read -r nombre; do
        [ -n "${nombre}" ] && BINARIOS_REQUERIDOS["${nombre}"]=1
    done < <(ls -1 "${dir_base}" 2>/dev/null)
done

# 9.2. Mínimos indispensables, aunque la base esté incompleta.
for nombre in dash bash sh ls cat cp mv rm mkdir rmdir chmod touch ln pwd echo date grep sed more; do
    BINARIOS_REQUERIDOS["${nombre}"]=1
done
if [ "${PERMITIR_SHELL}" = true ]; then
    BINARIOS_REQUERIDOS["scp"]=1
fi

BINARIOS_COPIADOS=0
for nombre in "${!BINARIOS_REQUERIDOS[@]}"; do
    # En modo solo SFTP no se copian clientes OpenSSH: también envejecen
    # con cada actualización del host y no son necesarios en el chroot.
    if [ "${PERMITIR_SHELL}" = false ] && { [ "${nombre}" = "scp" ] || [ "${nombre}" = "ssh" ]; }; then
        echo "  ⏭️  Omitido (modo solo SFTP): ${nombre}"
        continue
    fi

    origen_bin=""
    if origen_bin=$(buscar_binario_base "${nombre}"); then
        :
    elif origen_bin=$(buscar_binario_host "${nombre}"); then
        :
    fi
    if [ -z "${origen_bin}" ]; then
        echo "  ⚠️  No se encontró el binario ${nombre} en la base ni en el host"
        continue
    fi

    destino_bin="${JAIL}/usr/bin/${nombre}"
    mkdir -p "$(dirname "${destino_bin}")"
    # -L resuelve enlaces simbólicos (sh -> dash, vi -> alternatives, etc.)
    if cp -fL "${origen_bin}" "${destino_bin}" 2>/dev/null; then
        chmod 755 "${destino_bin}" 2>/dev/null || true
        BINARIOS_COPIADOS=$((BINARIOS_COPIADOS + 1))
    else
        echo "  ⚠️  No se pudo copiar ${origen_bin} -> ${destino_bin}"
    fi
done
echo "  ✅ ${BINARIOS_COPIADOS} binarios copiados en ${JAIL}/bin"

# 9.3. Copiar los árboles de librerías de la base. Se cubren ambos layouts:
# lib/ + lib64/ (clásico) y usr/lib/ + usr/lib64/ (usrmerge). Como el destino
# también es usrmerge, lib y lib64 son enlaces y ambas rutas escriben en usr/.
echo "📚 Copiando librerías..."
for par in "lib:lib" "lib64:lib64"; do
    origen_lib="${JAIL_ORIGEN}/${par%%:*}"
    [ -d "${origen_lib}" ] || continue
    copiar_arbol "${origen_lib}" "${JAIL}/usr/${par##*:}"
done

real_lib_origen="$(readlink -f "${JAIL_ORIGEN}/lib" 2>/dev/null || true)"
real_usrlib_origen="$(readlink -f "${JAIL_ORIGEN}/usr/lib" 2>/dev/null || true)"
if [ -n "${real_usrlib_origen}" ] && [ "${real_lib_origen}" != "${real_usrlib_origen}" ]; then
    copiar_arbol "${JAIL_ORIGEN}/usr/lib" "${JAIL}/usr/lib"
fi
real_lib64_origen="$(readlink -f "${JAIL_ORIGEN}/lib64" 2>/dev/null || true)"
real_usrlib64_origen="$(readlink -f "${JAIL_ORIGEN}/usr/lib64" 2>/dev/null || true)"
if [ -n "${real_usrlib64_origen}" ] && [ "${real_lib64_origen}" != "${real_usrlib64_origen}" ]; then
    copiar_arbol "${JAIL_ORIGEN}/usr/lib64" "${JAIL}/usr/lib64"
fi

# 9.4. Resolver dependencias restantes con ldd. Si la base no traía alguna
# librería, se toma del host para que los binarios puedan ejecutarse.
for bin in "${JAIL}"/usr/bin/*; do
    [ -f "${bin}" ] || continue
    ldd "${bin}" 2>/dev/null | grep "=> /" | awk '{print $3}' | while read -r lib; do
        [ -n "${lib}" ] || continue
        [ -e "${JAIL}${lib}" ] && continue
        origen_lib=""
        for candidato in "${JAIL_ORIGEN}${lib}" "${JAIL_ORIGEN}/usr${lib}" "${lib}" "/usr${lib}"; do
            if [ -e "${candidato}" ]; then
                origen_lib="${candidato}"
                break
            fi
        done
        [ -n "${origen_lib}" ] || continue
        destino_lib="${JAIL}${lib}"
        mkdir -p "$(dirname "${destino_lib}")"
        cp -fL "${origen_lib}" "${destino_lib}" 2>/dev/null || true
    done
done

# 9.5. Copiar el intérprete dinámico (linker), tomando la versión de la base
# si existe. Se cubren x86_64 y aarch64.
for linker in /lib64/ld-linux-x86-64.so.2 /lib/ld-linux.so.2 /lib64/ld-linux-aarch64.so.1 /lib/ld-linux-aarch64.so.1; do
    origen_linker=""
    for candidato in "${JAIL_ORIGEN}${linker}" "${JAIL_ORIGEN}/usr${linker}" "${linker}"; do
        if [ -e "${candidato}" ]; then
            origen_linker="${candidato}"
            break
        fi
    done
    [ -n "${origen_linker}" ] || continue
    destino_linker="${JAIL}${linker}"
    mkdir -p "$(dirname "${destino_linker}")"
    cp -fL "${origen_linker}" "${destino_linker}" 2>/dev/null || true
    chmod 755 "${destino_linker}" 2>/dev/null || true
done

# 9.6. El subsistema SFTP debe usar el internal-sftp embebido en el sshd del
# host, de modo que las actualizaciones de OpenSSH se apliquen al chroot.
# Se elimina después de copiar librerías para que no se reintroduzca.
rm -rf "${JAIL}/usr/lib/openssh" "${JAIL}/usr/lib/sftp-server"

# 9.7. Verificación: no continuar en silencio si el jail quedó sin contenido.
BINARIOS_JAIL=$(find "${JAIL}/usr/bin" -maxdepth 1 -type f -perm -u+x 2>/dev/null | wc -l)
LIBRERIAS_JAIL=$(find -L "${JAIL}/usr/lib" "${JAIL}/usr/lib64" -maxdepth 4 -type f -name 'lib*.so*' 2>/dev/null | wc -l)
if [ "${BINARIOS_JAIL}" -eq 0 ] || [ "${LIBRERIAS_JAIL}" -eq 0 ]; then
    echo "❌ El chroot quedó incompleto: ${BINARIOS_JAIL} binarios y ${LIBRERIAS_JAIL} librerías."
    echo "   Revise la base ${JAIL_ORIGEN} y vuelva a ejecutar el script."
    exit 1
fi
echo "  ✅ ${LIBRERIAS_JAIL} librerías copiadas en ${JAIL}/lib"

# 10. Crear dispositivos
echo "🖥️   Creando dispositivos..."
mknod -m 666 "${JAIL}/dev/null" c 1 3 2>/dev/null || true
mknod -m 666 "${JAIL}/dev/zero" c 1 5 2>/dev/null || true
mknod -m 644 "${JAIL}/dev/random" c 1 8 2>/dev/null || true
mknod -m 644 "${JAIL}/dev/urandom" c 1 9 2>/dev/null || true

# 10.1. Enlazar /dev/log dentro del jail para que el logging de
# internal-sftp (-l VERBOSE) sobreviva al chroot. Sin esto, OpenSSH intenta
# escribir al socket /dev/log ya dentro de la jail, no lo encuentra y las
# operaciones de archivo se pierden en silencio (solo queda la autenticación,
# que registra el sshd del host antes del chroot).
asegurar_dev_log_jail() {
    local jail="${1}" punto="${1}/dev/log" linea_fstab

    mkdir -p "${jail}/dev"
    [ -e "${punto}" ] || touch "${punto}" || {
        echo "⚠️  No se pudo crear ${punto}; las transferencias SFTP no se registrarán."
        return 0
    }

    if ! grep -q " ${punto} " /proc/mounts 2>/dev/null; then
        if mount --bind /dev/log "${punto}" 2>/dev/null; then
            echo "  ✅ /dev/log enlazado en ${punto}"
        else
            echo "⚠️  No se pudo montar --bind /dev/log en ${punto}."
            echo "   Las operaciones de archivo por SFTP no se registrarán en /var/log/auth.log."
            return 0
        fi
    else
        echo "  ℹ️  /dev/log ya estaba enlazado en ${punto}"
    fi

    # Persistir el montaje entre reinicios (nofail evita arrancue errores si
    # la jail se elimina manualmente).
    linea_fstab="/dev/log ${punto} none bind,nofail,noatime 0 0"
    if ! grep -qF "${punto}" /etc/fstab 2>/dev/null; then
        if echo "${linea_fstab}" >> /etc/fstab; then
            echo "  ✅ Entrada agregada a /etc/fstab (persistencia del log SFTP)"
        fi
    fi
    return 0
}
asegurar_dev_log_jail "${JAIL}"

# 11. Configurar permisos (igual que ${JAIL_ORIGEN})
echo "🔐 Configurando permisos..."
chown root:root "${JAIL}"
chmod 755 "${JAIL}"
chown -R "${USUARIO}:${USUARIO}" "${JAIL}/home/${USUARIO}"
chmod 700 "${JAIL}/home/${USUARIO}"
chmod 755 "${JAIL}"/{bin,lib,lib64,etc,dev}
chmod 1777 "${JAIL}/tmp"

# 11.1. Verificar que los binarios copiados pueden ejecutarse dentro del jail.
if [ -x "${JAIL}/bin/sh" ]; then
    if chroot "${JAIL}" /bin/sh -c 'exit 0' >/dev/null 2>&1; then
        echo "✅ Prueba de ejecución dentro del chroot: OK"
    else
        echo "⚠️  /bin/sh no pudo ejecutarse dentro del chroot (revise librerías)"
    fi
fi

# 12. Crear .bashrc (igual que ${JAIL_ORIGEN} probablemente)
echo "📝 Creando .bashrc..."
bash -c "cat > ${JAIL}/home/${USUARIO}/.bashrc << 'EOF'
# ~/.bashrc: executed by bash(1) for interactive shells.
PS1='[chroot] \u@\h:\w\$ '
export PATH=/bin:/usr/bin:/usr/local/bin:/usr/sbin
export TERM=xterm-256color
export HOME=/home/${USUARIO}
export SHELL=/bin/bash
alias ll='ls -la'
alias l='ls -l'
alias la='ls -a'
EOF"
chown "${USUARIO}:${USUARIO}" "${JAIL}/home/${USUARIO}/.bashrc"
chmod 644 "${JAIL}/home/${USUARIO}/.bashrc"

# 13. Crear archivo de configuración SSH independiente en sshd_config.d/
echo "⚙️  Creando configuración SSH en ${SSHD_CONFIG}..."

# Asegurar que el directorio existe
mkdir -p /etc/ssh/sshd_config.d/

# Crear el archivo de configuración específico para ${USUARIO}
{
    echo "# Configuración chroot para ${USUARIO}"
    echo "# Creado: $(date)"
    echo ""
    echo "Match User ${USUARIO}"
    echo "    # Habilitar autenticación por contraseña para este usuario aunque"
    echo "    # la configuración global de sshd use 'PasswordAuthentication no'."
    echo "    # Los valores dentro de un bloque Match tienen prioridad sobre los globales."
    echo "    PasswordAuthentication yes"
    echo "    ChrootDirectory ${JAIL}"
    echo "    AllowAgentForwarding no"
    echo "    AllowTcpForwarding no"
    echo "    AllowStreamLocalForwarding no"
    echo "    PermitTunnel no"
    echo "    X11Forwarding no"
    if [ "${PERMITIR_SHELL}" = true ]; then
        echo "    PermitTTY yes"
    else
        echo "    ForceCommand internal-sftp -l VERBOSE -d /home/${USUARIO}"
        echo "    PermitTTY no"
    fi
} > "${SSHD_CONFIG}"

# Establecer permisos correctos para el archivo SSH
chmod 644 "${SSHD_CONFIG}"
echo "✅ Archivo creado: ${SSHD_CONFIG}"

# 14. Verificar que no haya conflictos con configuraciones existentes
echo "🔍 Verificando configuraciones duplicadas para ${USUARIO}..."
CONFLICTOS=$(grep -rlE "^[[:space:]]*Match[[:space:]]+User[[:space:]]+.*\b${USUARIO}\b" /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | grep -v -F "${SSHD_CONFIG}" || true)
if [ -n "${CONFLICTOS}" ]; then
    echo "⚠️  ATENCIÓN: Se encontraron entradas para ${USUARIO} en:"
    echo "${CONFLICTOS}" | sed 's/^/   - /'
    echo "   Recomiendo eliminarlas para evitar conflictos"
else
    echo "✅ No hay conflictos de configuración para ${USUARIO}"
fi

# 15. Validar la configuración SSH antes de reiniciar
echo "🔍 Validando configuración SSH..."
mkdir -p /run/sshd
if  sshd -t; then
    echo "✅ Configuración SSH válida"
else
    echo "❌ ERROR: Configuración SSH inválida"
    echo "   Revisa el archivo: ${SSHD_CONFIG}"
    exit 1
fi

# Verificar que, para este usuario, la autenticación por contraseña quede
# habilitada aunque la configuración global de sshd tenga
# 'PasswordAuthentication no'. El bloque Match User tiene prioridad.
PASSWORD_AUTH_EFECTIVA=$(sshd -T -C user=${USUARIO},host=localhost,addr=127.0.0.1 2>/dev/null \
    | awk '$1 == "passwordauthentication" { print $2; exit }')
if [ "${PASSWORD_AUTH_EFECTIVA}" = "yes" ]; then
    echo "✅ PasswordAuthentication habilitado para ${USUARIO}"
elif [ -n "${PASSWORD_AUTH_EFECTIVA}" ]; then
    echo "⚠️  ATENCIÓN: PasswordAuthentication=${PASSWORD_AUTH_EFECTIVA} para ${USUARIO}"
    echo "   El usuario podría no poder iniciar sesión con contraseña."
    echo "   Revise ${SSHD_CONFIG} y la configuración global de sshd."
else
    echo "ℹ️  No se pudo verificar PasswordAuthentication con 'sshd -T -C'"
fi

# 16. Reiniciar SSH
echo "🔄 Reiniciando servicio SSH..."
# El servicio SSH puede llamarse sshd, ssh o ssh.service según la distro
SSH_SERVICE=$(systemctl list-units --type=service --state=running 2>/dev/null | grep -oP 'ssh[d]?\.service' | head -1) || true
systemctl restart "${SSH_SERVICE:-ssh}"

# 17. Verificar instalación
# 
echo ""
echo "✅ Usuario ${USUARIO} creado con chroot en ${JAIL}"
echo ""
echo "📊 Resumen de configuración:"
if [ "${PERMITIR_SHELL}" = true ]; then
    echo "   - Modo: shell + SFTP"
    echo "   - SFTP: internal-sftp del sshd del host (Subsystem global)"
else
    echo "   - Modo: solo SFTP (sin shell interactivo)"
    echo "   - SFTP: internal-sftp del sshd del host (ForceCommand por usuario)"
    echo "   - Nota: scp -O (legacy) no funciona; use sftp o scp moderno"
fi
echo "   - sftp-server dentro del jail: NO (usa el del host)"
echo "   - Log SFTP: operaciones de archivo en /var/log/auth.log (nivel VERBOSE)"
echo "   - /dev/log enlazado en la jail: necesario para que internal-sftp registre tras el chroot"
echo "   - Autenticación por contraseña: habilitada para ${USUARIO}"
echo "   - /etc/passwd: Solo root y ${USUARIO}"
echo "   - /etc/shadow: NO EXISTE (autenticación por host)"
echo "   - /etc/group: Solo root y ${USUARIO}"
echo "   - Home: /home/${USUARIO} (700)"
echo "   - Archivos /etc/: Copiados desde ${JAIL_ORIGEN}"
echo "   - Configuración SSH: ${SSHD_CONFIG}"
echo ""
echo "🔍 Verificar contenido de /etc/passwd:"
cat "${JAIL}/etc/passwd"
echo ""
echo "🔍 Verificar configuración SSH:"
cat "${SSHD_CONFIG}"
echo ""
echo "🧪 Prueba la conexión:"
echo "   sftp ${USUARIO}@localhost"
if [ "${PERMITIR_SHELL}" = true ]; then
    echo "   ssh ${USUARIO}@localhost"
else
    echo "   ssh ${USUARIO}@localhost   # debe cerrar: usuario restringido a SFTP"
fi
echo ""
echo "📋 Para ver toda la configuración:"
echo "    ls -la ${JAIL}/etc/"
echo ""
echo "🗑️   Para eliminar el usuario y limpiar todo:"
echo "    $0 -d -u ${USUARIO}"